; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="yzj_onlyAIworkgames_Roguelike Survivors"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataTables="*res://autoload/data_tables.gd"
GameManager="*res://autoload/game_manager.gd"
UpgradePool="*res://autoload/upgrade_pool.gd"
SpawnManager="*res://autoload/spawn_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
ShopManager="*res://autoload/shop_manager.gd"
AffixManager="*res://autoload/affix_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"
EnemyManager="*res://scripts/systems/enemy_manager.gd"
NetManager="*res://scripts/systems/net_manager.gd"
TouchInput="*res://autoload/touch_input.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[editor_plugins]

enabled=PackedStringArray("godot_mcp")

[gui]

theme/default_theme="res://ui_theme.tres"

[rendering]

vram_compression/import_etc2_astc=true
textures/vram_compression/import_etc2_astc=true
